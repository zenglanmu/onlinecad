{
  "name": "@onlinecad/cad-acadrust",
  "version": "0.1.0",
  "description": "acadrust (Rust/WASM) DWG engine wired into @mlightcad/cad-viewer as a pluggable database converter",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "../../scripts/build-wasm.sh",
    "fixtures": "cargo run --release --manifest-path ../../crates/acadrust-wasm/Cargo.toml --example gen_fixture -- ../../fixtures",
    "test": "tsx --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mlightcad/data-model": "^1.15.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
